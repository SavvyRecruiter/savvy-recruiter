  </div>
</div>

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <div class="left">
        <span class="mono">§ recent issues</span>
        <h2>The Wednesday<br><span class="si">Briefing.</span></h2>
      </div>
      <div class="right">
        <p>Field-tested AI sourcing techniques, honest tool reviews from the 2026 lab, and the week's best automation recipe. Every issue free, forever.</p>
      </div>
    </div>

    <div class="issues">
      {% set newsletterposts = collections.newsletter | reverse %}
      {% for post in newsletterposts | limit(5) %}
      <a href="{{ post.url }}" class="issue">
        <span class="idx">{% if post.data.issue %}{{ post.data.issue }}{% else %}—{% endif %}</span>
        <div>
          <div class="issue-meta">
            {% if post.data.pillar %}<span class="pill">{{ post.data.pillar }}</span>{% endif %}
            <span class="date">{{ post.data.date | date('%d %b %Y') }}</span>
          </div>
          <div class="issue-title">{{ post.data.title }}</div>
        </div>
        <span class="arrow">→</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
