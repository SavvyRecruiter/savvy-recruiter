<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description or 'Proof of Work Sourcing for ML and robotics hiring. Weekly research, playbooks, and tool benchmarks from Brendan Williams.' }}">
  <title>{{ title }} — savvy/recruiter</title>

  <!-- Open Graph -->
  <meta property="og:title" content="{{ title }} — savvy/recruiter">
  <meta property="og:description" content="{{ description or 'Proof of Work Sourcing for ML and robotics hiring.' }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="savvy/recruiter">

  <!-- Fonts: Geist · Geist Mono · Instrument Serif -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">

  <!-- Shared stylesheet -->
  <link rel="stylesheet" href="/css/site.css">

  <!-- Beehiiv attribution (tracks subscribe-form signups) -->
  <script type="text/javascript" async src="https://subscribe-forms.beehiiv.com/attribution.js"></script>

  <!-- Favicon — s/ slash mark on teal -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%2319D5C5'/%3E%3Ctext x='32' y='46' font-family='Geist,sans-serif' font-size='44' font-weight='400' text-anchor='middle' fill='%230A0E0D'%3E/%3C/text%3E%3C/svg%3E">
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>

  <nav class="site-nav">
    <div class="nav-inner">
      <a href="/" class="brand" aria-label="savvy/recruiter — home">
        <span class="tile">/</span>
        <span class="wm">savvy<span class="slash">/</span>recruiter</span>
      </a>
      <div class="nav-links">
        <a href="/newsletters/" {% if page.url.startsWith('/newsletters') %}aria-current="page"{% endif %}>Newsletter</a>
        <a href="/playbooks/" {% if page.url.startsWith('/playbooks') %}aria-current="page"{% endif %}>Playbooks</a>
        <a href="/about/" {% if page.url.startsWith('/about') %}aria-current="page"{% endif %}>About</a>
        <a href="/subscribe/" class="cta">Subscribe →</a>
      </div>
    </div>
  </nav>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="foot-grid">
        <div class="foot-brand">
          <div class="wm">savvy<span class="slash">/</span>recruiter</div>
          <p>Proof of Work Sourcing for ML and robotics hiring. Weekly research, playbooks, and tool benchmarks from Brendan Williams — AI Sourcing Specialist, Manchester.</p>
        </div>
        <div class="foot-col">
          <h4>§ read</h4>
          <a href="/newsletters/">Newsletter archive</a>
          <a href="/playbooks/">Playbook library</a>
          <a href="/about/">About</a>
        </div>
        <div class="foot-col">
          <h4>§ connect</h4>
          <a href="https://www.linkedin.com/in/sourcing-strategist/" target="_blank" rel="noopener">LinkedIn</a>
          <a href="/subscribe/">Subscribe</a>
        </div>
      </div>
      <div class="foot-end">
        <span>© {{ page.date | date('%Y') }} savvy/recruiter · Manchester</span>
        <span class="si">proof over résumés.</span>
      </div>
    </div>
  </footer>

  <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "8e6a15c53ea24469aebefa4ccdcd32ec"}'></script>
</body>
</html>
