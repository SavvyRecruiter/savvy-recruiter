---
layout: base.njk
---
<article class="article">
  <div class="wrap">
    <header class="article-header">
      <a href="/newsletters/" class="back-link">← Back to newsletters</a>
      <div class="article-meta">
        {% if pillar %}<span class="article-pill">{{ pillar }}</span>{% endif %}
        {% if issue %}<span class="article-date">Issue {{ issue }}</span>{% endif %}
        <span class="article-date">{{ date | date('%d %b %Y') }}</span>
      </div>
      <h1>{{ title }}</h1>
      {% if dek %}<p class="article-dek">{{ dek }}</p>{% endif %}
    </header>

    <div class="prose">
      {{ content | safe }}
    </div>

    <div class="article-footer">
      <div class="eyebrow">§ read next</div>
      <p>Browse all issues in the <a href="/newsletters/">newsletter archive</a>, or explore the <a href="/playbooks/">playbook library</a>.</p>
    </div>
  </div>
</article>
