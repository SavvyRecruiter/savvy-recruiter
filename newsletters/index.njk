---
layout: base.njk
title: The Wednesday Briefing
description: Every issue of The Wednesday Briefing — field-tested AI sourcing techniques, honest tool reviews, and automation recipes for ML and robotics recruiting.
permalink: /newsletters/
eleventyExcludeFromCollections: true
---

<header class="page-hero">
  <div class="wrap">
    <div class="eyebrow">§ the newsletter</div>
    <h1>The Wednesday<br><span class="si">Briefing.</span></h1>
    <p class="lede">One email, every Wednesday. Field-tested AI sourcing techniques, honest tool reviews from the 2026 lab, and the week's best automation recipe. Free, forever.</p>
  </div>
</header>

<section class="page-body">
  <div class="wrap">
    {% set newsletters = collections.newsletter | reverse %}

    {# Pillar → colour map. Teal is default; others code by category. #}
    {% set pillarColors = {
      "Methodology": "var(--teal)",
      "Automation": "var(--ember)",
      "Research": "var(--teal)",
      "Build Log": "var(--teal)",
      "Hidden Platforms": "var(--p-hidden)",
      "Tool Reviews": "var(--teal)",
      "Contrarian": "var(--ember)"
    } %}

    {% if newsletters.length > 0 %}

      {# Featured: latest issue #}
      {% for post in newsletters | limit(1) %}
      {% set pillarColor = pillarColors[post.data.pillar] or "var(--teal)" %}
      <a href="{{ post.url }}" class="featured" style="--pillar-color: {{ pillarColor }};">
        <div class="featured-eyebrow">
          <span class="pip"></span>
          <span>Latest issue{% if post.data.issue %} · no. {{ post.data.issue }}{% endif %}</span>
        </div>
        <div class="issue-meta">
          {% if post.data.pillar %}<span class="pill" style="--pillar-color: {{ pillarColor }};">{{ post.data.pillar }}</span>{% endif %}
          <span class="date">{{ post.data.date | date('%d %b %Y') }}</span>
        </div>
        <h2 class="featured-title">{{ post.data.title }}</h2>
        {% if post.data.dek %}<p class="featured-dek">{{ post.data.dek }}</p>{% endif %}
        <span class="featured-cta">Read the issue →</span>
      </a>
      {% endfor %}

      {# The archive #}
      {% if newsletters.length > 1 %}
      <div class="eyebrow" style="margin: 56px 0 8px;">§ the archive</div>
      <div class="issues">
        {% for post in newsletters %}
          {% if not loop.first %}
          {% set pillarColor = pillarColors[post.data.pillar] or "var(--teal)" %}
          <a href="{{ post.url }}" class="issue" style="--pillar-color: {{ pillarColor }};">
            <span class="idx">{% if post.data.issue %}{{ post.data.issue }}{% else %}—{% endif %}</span>
            <div>
              <div class="issue-meta">
                {% if post.data.pillar %}<span class="pill" style="--pillar-color: {{ pillarColor }};">{{ post.data.pillar }}</span>{% endif %}
                <span class="date">{{ post.data.date | date('%d %b %Y') }}</span>
              </div>
              <div class="issue-title">{{ post.data.title }}</div>
              {% if post.data.dek %}<p class="issue-dek">{{ post.data.dek }}</p>{% endif %}
            </div>
            <span class="arrow">→</span>
          </a>
          {% endif %}
        {% endfor %}
      </div>
      {% endif %}

    {% else %}
      <p style="color: var(--t2); font-size: 18px;">The first issue publishes Wednesday. Check back then, or follow <a href="https://www.linkedin.com/in/sourcing-strategist/" target="_blank" rel="noopener" style="color: var(--teal);">Brendan on LinkedIn</a> for the announcement.</p>
    {% endif %}
  </div>
</section>
